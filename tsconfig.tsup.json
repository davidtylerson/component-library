{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/themes/**/*",
    "src/email/**/*",
    "src/components/**/*",
    "src/lib/**/*",
    "src/tokens/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/app",
    "src/stories",
    ".storybook",
    "docs",
    "next-env.d.ts",
    ".next",
    "src/components/SidebarNavClient.tsx",
    "src/themes/catalog.tsx"
  ]
} 