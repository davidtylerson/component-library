{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "module": "commonjs",
    "target": "es2018",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/app",
    "src/stories",
    ".storybook",
    "docs",
    "next-env.d.ts",
    ".next",
    "src/components/SidebarNavClient.tsx",
    "src/themes/catalog.tsx"
  ],
  "include": [
    "src/index.ts",
    "src/components/ui/**/*",
    "src/components/email/**/*",
    "src/components/typography/**/*",
    "src/lib/**/*",
    "src/tokens/**/*",
    "src/themes/**/*"
  ]
} 