{
  "name": "@tydavidson/design-system",
  "version": "1.2.9",
  "description": "Float Design System with email components and theme system",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.mjs",
      "require": "./dist/email/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs",
      "require": "./dist/themes/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./styles/globals.css": "./dist/styles/globals.css"
  },
  "files": [
    "dist",
    "src/themes/theme.css",
    "docs"
  ],
  "keywords": [
    "design-system",
    "components",
    "email",
    "react"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next-themes": ">=0.2.0",
    "@tabler/icons-react": ">=2.0.0"
  },
  "author": "Float Technologies",
  "license": "ISC",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "ui:add": "pnpm dlx shadcn-ui@latest add",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:lib": "tsup",
    "build:email": "tsc --project tsconfig.email.json",
    "build:all": "npm run build:lib && npm run build:email && npm run copy-css",
    "copy-css": "mkdir -p dist/styles && cp src/app/globals.css dist/styles/globals.css",
    "prepublishOnly": "npm run build:all",
    "clean": "rm -rf dist",
    "dev:lib": "npm run build:all -- --watch"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.19.2",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-aspect-ratio": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.8",
    "@radix-ui/react-context-menu": "^2.2.12",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.1.11",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.3.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slider": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-toggle": "^1.1.6",
    "@radix-ui/react-toggle-group": "^1.1.7",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@tabler/icons-react": "^2.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "next": "^15.3.1",
    "next-svgr": "^0.0.2",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-day-picker": "^9.6.7",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.0.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3",
    "@shadcn/ui": "^0.0.4",
    "@storybook/addon-a11y": "^7.6.6",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-links": "^7.6.6",
    "@storybook/addon-onboarding": "^8.6.12",
    "@storybook/addon-themes": "^7.6.6",
    "@storybook/blocks": "^8.6.12",
    "@storybook/experimental-addon-test": "^8.6.12",
    "@storybook/nextjs": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.13.3",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.31",
    "storybook": "^8.6.12",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3"
  }
}
