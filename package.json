{
  "name": "float-vibe-foundry",
  "version": "1.0.0",
  "private": true,
  "description": "Float Vibe Foundry - Design System & Applications",
  "scripts": {
    "dev": "pnpm --parallel --filter design-system --filter float-mail dev",
    "build": "pnpm --recursive build",
    "lint": "eslint packages/design-system/src packages/float-mail/src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint packages/design-system/src packages/float-mail/src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "clean": "pnpm --recursive clean",
    "test": "pnpm --recursive test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/mcp": "^0.0.32",
    "playwright": "^1.48.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "next-svgr": "^0.0.2",
    "postcss": "^8.4.31",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
