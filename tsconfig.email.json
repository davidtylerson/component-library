{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/email",
    "rootDir": "./src/components/email",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "module": "commonjs",
    "target": "es2018",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/components/email/**/*"],
  "exclude": ["node_modules", "dist", "src/app", "src/stories", ".storybook", "docs"]
} 